


# first we need to import our visualization libraries and any other related components!

import json  # needed to parse geojson
import re    # needed for wordcloud example

import matplotlib.pyplot as plt   # for word clouds
import pandas as pd  # using data frames with our plotly visualizations
import plotly.express as px  # px shorthand is used in plotly examples
import pydeck as pdk  # pdk is used as shorthand for pydeck examples

from IPython.display import HTML, IFrame  # needed to display pydeck visualizations in the notebook
from wordcloud import STOPWORDS, WordCloud  # STOPWORDS is a filter for word frequency counting





house = pd.read_csv("house_average_recent.csv")
senate = pd.read_csv("senate_average_recent.csv")

# preview what's in each file:
house.tail()


senate.tail()


len(senate)





# round(1) means round the number to a single decimal point
senate["other"] = (100 - senate["dem"] - senate["rep"]).clip(lower=0).round(1) 

senate.tail()


party_names = {"dem": "Democrat",  "other": "Other/undecided", "rep": "Republican"}

colors = {"Democrat": "blue", "Other/undecided": "grey", "Republican": "red"}

senate_sorted = senate.sort_values("margin").rename(columns=party_names)

fig = px.bar(
    senate_sorted, # the data we want to visualize
    x=["Democrat", "Other/undecided", "Republican"], #the x axis
    y="state",  # the y axis
    orientation="h", 
    color_discrete_map=colors, #directly map colors to columns
    labels={"value":"Percent", "state": "State"},
    hover_data={"polls":True,"latest":True}, # selecting extra columns to display on mouse hover
    height=800, # height of graph, setting this explicitly so it's big enough to display everything
    title="average senate polling (late October-Nov 2)"
)

fig.update_layout(
    legend_title_text="Voter intention",
    xaxis_title="Percentage of polled voters",
    xaxis_range=[0,100]  # stretches data across full width of graph
)

fig.show()  # displays the graph





red = "214, 40, 40"  # is the RGB representation of "red"
blue = "30, 80, 216"  # rgb representation of blue

# we can define a color scale by which our data will be represented

color_scale = [
    [0.0, f"rgba({red}, 1)"], # 1 is most opaque for the "a" value of rgba color
    [0.5, f"rgba({red}, 0.2)"], # 0.2 will read as barely opaque
    [0.5, f"rgba({blue}, 0.2)"],
    [1.0, f"rgba({blue}, 1)"]
]

colorbar = {
    "title": "Lead by margin",
    "tickvals": [-20, -10, 0, 10, 20],
    "ticktext": ["R+20", "R+10", "Tie", "D+10", "D+20"],
}

fig = px.choropleth(
    senate,
    locations="state", # this tells the plotly library which column of our data contains location information
    locationmode="USA-states", # this tells plotly that we are dealing with US state data and to plot accordlingly
    scope="usa", # zooms in on the US,
    color="margin", #give color to each region based on "margin" column of dataset
    color_continuous_scale=color_scale,
    range_color=[-20,20],
    height=600,
    title="US Senate polling data"
)

fig.update_geos(landcolor="grey")

fig.show()
