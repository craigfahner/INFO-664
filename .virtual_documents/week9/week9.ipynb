





import pandas as pd  # this imports the pandas library under the nickname 'pd' which is used in a lot of online documentation


# we first create a dataframe using the read_csv() method

df = pd.read_csv('woman_500.csv') # df is the variable that holds my dataframe


df  # output the dataframe to the notebook





df.head(3)  # head gives me the first items in the dataframe. the argument is how many items to display


df.tail(3) # tail shows the last items in the dataframe


# the info() method gives us an overview of what's in the dataframe

print(df.info())


# we can also print attributes about the dataframe using df.shape and df.columns

print(df.shape) # the "dimensions" of the dataframe - 500 rows long, 59 columns wide


print(df.columns)  # .tolist() method converts this to a list


df['medium']  # putting the heading as a string in square brackets following a dataframe will output all the values of that column


df.medium[25:40]  # you can also just put the name of the column directly after the dataframe after a dot (.)
